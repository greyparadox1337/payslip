# Copy this file to .env.local and fill in your real values
# Run: cp .env.example .env.local

# ── MongoDB ──────────────────────────────────────────────
# Get this from MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/payslip?retryWrites=true&w=majority

# ── NextAuth ─────────────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-secret-here
# Set to your local dev URL or custom domain. On Vercel, NEXTAUTH_URL is automatically handled.
NEXTAUTH_URL=http://localhost:3000


# ── Robinhood Chain (no keys needed — public RPC) ────────
# testnet = chain 46630, mainnet = chain 4663
NEXT_PUBLIC_CHAIN_ENV=testnet
# Override only if you want a dedicated node (e.g. Alchemy) instead of the public RPC.
# Testnet public: https://rpc.testnet.chain.robinhood.com
# Mainnet public: https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_RPC=https://rpc.testnet.chain.robinhood.com
# Testnet ETH for gas: https://faucet.testnet.chain.robinhood.com

# ── Firebase (for TrustCert — optional for PaySlip) ──────
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# ── Email (optional — for invite emails) ─────────────────
RESEND_API_KEY=re_your_key_here